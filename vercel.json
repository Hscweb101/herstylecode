{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 6 */4 * *"
    }
  ],
  "functions": {
    "api/seo.js": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/product/:slug", "destination": "/api/seo?type=product&slug=:slug" },
    { "source": "/category/:slug", "destination": "/api/seo?type=category&slug=:slug" },
    { "source": "/collections/:slug", "destination": "/api/seo?type=collection&slug=:slug" },
    { "source": "/blog/:slug", "destination": "/api/seo?type=blogpost&slug=:slug" },
    { "source": "/page/:slug", "destination": "/api/seo?type=page&slug=:slug" },
    { "source": "/shop", "destination": "/api/seo?type=shop" },
    { "source": "/blog", "destination": "/api/seo?type=blog" },
    { "source": "/faq", "destination": "/api/seo?type=faq" },
    { "source": "/care-instructions", "destination": "/api/seo?type=care" },
    { "source": "/contact", "destination": "/api/seo?type=contact" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
